# OpenAI-compatible provider settings. Never commit your real API key.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
STS2_BRIDGE_URL=http://127.0.0.1:38281
# Clone 安装通常无需设置；独立移动 agent 时填写 mcp/server 的绝对路径。
STS2_MCP_DIRECTORY=
# 可选：替换 Skill 目录；至少包含 SKILL.md 及明确引用的文件。脚本可选，仅加载可信本地代码。
STS2_SKILL_PATH=
# 可选本机日志目录；默认使用系统本地数据目录，不放进仓库。
# STS2_JOURNAL_DIR=C:\Users\你的用户名\AppData\Local\Sts2StateBridge\journals
