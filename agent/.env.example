# OpenAI-compatible provider settings. Never commit your real API key.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
STS2_BRIDGE_URL=http://127.0.0.1:38281
# Clone 安装通常无需设置；独立移动 agent 时填写 mcp/server 的绝对路径。
STS2_MCP_DIRECTORY=
# 可选：替换内置战士 Skill 的目录，目录内必须包含 SKILL.md 和 references/ironclad-playbook.md。
STS2_SKILL_PATH=
